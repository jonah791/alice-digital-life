{
  "_comment": "生态中心仓目录的「编辑部分」：插件 → 层次归属。机械部分（名称/一句话定位/计数）由 catalog/gen-catalog.py 从各插件 package.json 生成，不在此维护。⚠ key 用插件**目录名**（个别插件目录名 ≠ 包名，如 manor 的包名是 dsh-manor）。",
  "_layers": [
    { "id": "life",     "name": "生命层", "duty": "存在方式：存在状态机 / 睡眠 / 自我激活 / 时间线 / 存档 / 时间坐标" },
    { "id": "cognition","name": "认知层", "duty": "记忆、技能、进化、自我检验、证据与测量——自我更新的核心" },
    { "id": "perceive", "name": "感知层", "duty": "环境感知：浏览器控制台 / 网页内容 / 视觉 / 屏幕 / 文档" },
    { "id": "act",      "name": "行动层", "duty": "任务执行与专业工具" },
    { "id": "comm",     "name": "通信层", "duty": "人机交互与实例互通：远程连接 / 告警出口 / 多实例总线" },
    { "id": "govern",   "name": "治理层", "duty": "运行保障：守护 / 哨兵 / 预检 / 插件管理 / 上下文治理 / LLM 运维 / 会话与目标生命周期" },
    { "id": "present",  "name": "呈现层", "duty": "自我表达：养成档案 / 独立面板 / 插件生成" },
    { "id": "security", "name": "安全层", "duty": "授权测试与防御：交战闭环 / 本机态势 / 注入防御 / 身份闭环（仅限授权场景）" }
  ],
